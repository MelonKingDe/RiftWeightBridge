	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["com.example.riftweight.RiftWeightMod"]
	},
	"mixins": ["riftweight.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
